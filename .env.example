# Copy to .env and fill in. Never commit the real .env.
# docker compose reads this file; `manage.py` outside docker reads whatever is exported
# in your shell, so the same names work either way.

# ----------------------------------------------------------------- Django
# required; generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# origins the browser uses, needed for admin logins behind the nginx proxy
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# set to True once the deployment terminates TLS
DJANGO_SECURE_SSL=False
DJANGO_LOG_LEVEL=INFO

# ----------------------------------------------------------------- database
# 'postgres' (docker compose sets this) or 'sqlite' for a quick local run
DJANGO_DB_ENGINE=sqlite
POSTGRES_DB=elearn
POSTGRES_USER=elearn
# required when DJANGO_DB_ENGINE=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ----------------------------------------------------------------- redis
# one server; the project uses db 0 for celery, 1 for the cache, 2 for channels
REDIS_URL=redis://127.0.0.1:6379

# ----------------------------------------------------------------- email
# leave EMAIL_HOST_USER empty to print activation codes to the log instead of sending them
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True

# ----------------------------------------------------------------- API
# seconds a login token stays valid (default 7 days)
API_TOKEN_MAX_AGE=604800
# per-IP limits on the unauthenticated auth endpoints
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_CODE=8/min
# only needed when the SPA is served from a different origin than Django; the bundled
# nginx puts both on one origin, so leave this empty
CORS_ALLOWED_ORIGINS=

# ----------------------------------------------------------------- docker compose
# host port the app is published on
FRONTEND_PORT=8080
